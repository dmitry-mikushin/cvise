/* These replace autoconf probes for signatures that POSIX has fixed for a
   quarter of a century. There is nothing left to detect: readlink returns
   ssize_t and takes a size_t, scandir's comparators take const pointers, and
   utimes takes a struct timeval array. A build that needed the probes would be
   a build on a system this tool cannot run on anyway. */
/* These are declarator macros, not type names: each expands to the whole
   declaration of a parameter with the given name, which is how the wrappers
   use them. */
#define READLINK_TYPE_RETURN ssize_t
#define READLINK_TYPE_ARG3(name) size_t name
#define SCANDIR_TYPE_ARG3(name) int (*name)(const struct dirent *)
#define SCANDIR_TYPE_ARG4(name) int (*name)(const struct dirent **, const struct dirent **)
#define UTIMES_TYPE_ARG2(name) const struct timeval name[2]

/* Identity, for the diagnostics the wrappers print. */
#define PACKAGE "cvise-overlay"
#define VERSION "@cvise_VERSION@"

#endif
